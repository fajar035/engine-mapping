{
  "expo": {
    "name": "Engine Mapping",
    "slug": "engine-mapping",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/ios/AppIcon-1024.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c0f14",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rigging.enginemapping"
    },
    "android": {
      "package": "com.rigging.enginemapping",
      "adaptiveIcon": {
        "backgroundColor": "#0c0f14",
        "foregroundImage": "./assets/icon/android/adaptive-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c0f14",
          "image": "./assets/icon/ios/AppIcon-1024.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0c0f14",
            "image": "./assets/icon/ios/AppIcon-1024.png"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "294299dc-38a3-4bcb-8ae6-2e98d9e6aba2"
      }
    }
  }
}
